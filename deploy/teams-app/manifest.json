{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.5.0",
  "id": "{{APP_ID}}",
  "developer": {
    "name": "Grok Bot",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "Haitch Audio",
    "full": "Haitch (audio assistant)"
  },
  "description": {
    "short": "Join Teams meetings as a talking assistant.",
    "full": "Visible audio assistant that joins the meeting to talk and take notes. Outbound camera-tile still only — the bot does not receive participant video. Never a hidden listener."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#5B2C6F",
  "bots": [
    {
      "botId": "{{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsCalling": true,
      "supportsVideo": true
    }
  ],
  "permissions": ["identity"],
  "validDomains": []
}
