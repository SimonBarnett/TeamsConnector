# MCP host
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8787
LOG_LEVEL=info

# Artifact envelope encryption (32-byte key, base64). Required in production.
ARTIFACT_ENCRYPTION_KEY=

# Postgres persistence (PgStore). Unset = in-memory.
# DATABASE_URL=postgres://teamsjoin:teamsjoin@localhost:5432/teams_audio_join
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=uksouth

# Microsoft identity (Track A)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# PEM path or PEM contents (alternative to AZURE_CLIENT_SECRET)
AZURE_CLIENT_CERTIFICATE=
GRAPH_USER_ID=

# Assistant display name shown in the Teams roster
ASSISTANT_DISPLAY_NAME=Haitch (audio assistant)

# xAI / SpaceXAI — grounded summaries
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Optional tenant event webhook
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_SECRET=

# Media worker. Unset URL = in-process loopback (demo). Set URL to the Windows worker.
MEDIA_WORKER_URL=
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_SECRET=
# Worker process (services/media-worker): Graph callback must be reachable by Microsoft.
# CALLBACK_URI=https://your-host/callback
# PUBLIC_BASE_URL=https://your-host
# ORCHESTRATOR_URL=http://127.0.0.1:8787

# Calendar connector (read-only). Fake calendar is used when unset.
CALENDAR_CONNECTOR_URL=
WORKFLOW_TRIGGER=0

# Track A live poll interval (ms). Default 15000 when AZURE_* is set, 0 in fixture mode.
# TRANSCRIPT_POLL_MS=15000
