<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TeamsAudioJoin.MediaHost</RootNamespace>
    <AssemblyName>TeamsAudioJoin.MediaHost</AssemblyName>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graph.Communications.Calls.Media" Version="1.2.0.17950" />
    <PackageReference Include="Microsoft.Skype.Bots.Media" Version="1.31.0.225-preview" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.43.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\media-worker\AudioRingBuffer.cs" Link="Shared\AudioRingBuffer.cs" />
    <Compile Include="..\media-worker\AzureStt.cs" Link="Shared\AzureStt.cs" />
    <Compile Include="..\media-worker\AzureTts.cs" Link="Shared\AzureTts.cs" />
    <Compile Include="..\media-worker\CallRegistry.cs" Link="Shared\CallRegistry.cs" />
    <Compile Include="..\media-worker\GraphJoin.cs" Link="Shared\GraphJoin.cs" />
    <Compile Include="..\media-worker\LiveHearPump.cs" Link="Shared\LiveHearPump.cs" />
    <Compile Include="..\media-worker\PcmWav.cs" Link="Shared\PcmWav.cs" />
    <Compile Include="..\media-worker\PhraseCanon.cs" Link="Shared\PhraseCanon.cs" />
    <Compile Include="..\media-worker\PublicBase.cs" Link="Shared\PublicBase.cs" />
    <Compile Include="..\media-worker\TtsPcmPlayer.cs" Link="Shared\TtsPcmPlayer.cs" />
  </ItemGroup>
</Project>
